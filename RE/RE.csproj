<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWindowsForms>True</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<ApplicationIcon>RealEngine.ico</ApplicationIcon>
		<Title>Real Engine</Title>
		<Version>1.2.3.4</Version>
		<Authors>DimucaTheDev</Authors>
		<Company>LEFT2.DEV</Company>
		<Product>Real Engine</Product>
		<PackageProjectUrl>https://github.com/DimucaTheDev/RealEngine</PackageProjectUrl>
		<Description>REAL Engine!!!!!! A replacement for Unreal Engine 7</Description>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="RE.Utils.BuildDateAttribute">
			<_Parameter1>$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<Target Name="AddGitCommitHash" BeforeTargets="CoreGenerateAssemblyInfo">
		<Exec Command="git rev-parse HEAD" ConsoleToMSBuild="true" ContinueOnError="true">
			<Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHash" />
		</Exec>

		<ItemGroup>
			<AssemblyAttribute Include="RE.Utils.GitCommitAttribute">
				<_Parameter1>$(GitCommitHash)</_Parameter1>
			</AssemblyAttribute>
		</ItemGroup>
	</Target>




	<ItemGroup>
		<Compile Remove="Assets\GenerateSoundMap.cs" />
		<Compile Remove="Assets\GenerateStaticModel.cs" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\RealEngine.ico" />
		<Resource Include="RealEngine.ico" />
	</ItemGroup>



	<ItemGroup>
		<PackageReference Include="AssimpNet" Version="4.1.0" />
		<PackageReference Include="BulletSharp" Version="0.11.1" />
		<PackageReference Include="FmodAudio" Version="2.2.5" />
		<PackageReference Include="freetype" Version="2.8.0.1" />
		<PackageReference Include="ImGui.NET" Version="1.90.0.1" />
		<PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
		<PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" />
		<PackageReference Include="OpenTK" Version="4.9.4" />
		<PackageReference Include="Serilog" Version="4.3.0" />
		<PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
		<PackageReference Include="SpaceWizards.SharpFont" Version="1.0.2" />
		<PackageReference Include="StbImageSharp" Version="2.30.15" />
		<PackageReference Include="System.Drawing.Common" Version="9.0.8" />
	</ItemGroup>


	<ItemGroup>
		<None Update="Assets\**">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>


	<ItemGroup>
		<None Update="Dll\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>


	<ItemGroup>
		<Folder Include="Assets\Audio\" />
		<Folder Include="Assets\Cfg\" />
	</ItemGroup>


	<ItemGroup>
		<None Include="Assets\GenerateSoundMap.cs">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="Assets\GenerateStaticModel.cs">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
