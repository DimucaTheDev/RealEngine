<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType Condition="'$(Configuration)'=='Debug'">Exe</OutputType>
		<OutputType Condition="'$(Configuration)'!='Debug'">Library</OutputType>

		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWindowsForms>False</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>

		<Configurations>Debug;Release;Production</Configurations>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<Platforms>AnyCPU;x64</Platforms>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<NoWarn>NU1701;NU1702;NU1510;CS1591</NoWarn>
		<Company>CMDEV</Company>
	</PropertyGroup>

	<Target Name="AddGitCommitHash" BeforeTargets="CoreGenerateAssemblyInfo">
		<Exec Command="git rev-parse HEAD" ConsoleToMSBuild="true" ContinueOnError="true">
			<Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHash" />
		</Exec>

		<ItemGroup>
			<AssemblyAttribute Include="RE.Utils.GitCommitAttribute">
				<_Parameter1>$(GitCommitHash)</_Parameter1>
			</AssemblyAttribute>
		
			<AssemblyAttribute Include="RE.Utils.BuildDateAttribute">
				<_Parameter1>$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</_Parameter1>
			</AssemblyAttribute>
		</ItemGroup>

	</Target>

	<Import Project="..\BuildTargets\RE.Common.targets" /> 
	<Import Project="..\BuildTargets\RE.Publish.targets" Condition="'$(Configuration)'=='Production'" />

	<ItemGroup>
