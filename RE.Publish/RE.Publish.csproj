<Project>
  <PropertyGroup>
    <PubDir>$([System.IO.Path]::GetFullPath('..\ProductionBuild\'))</PubDir>
    <TaskDll>..\RE.BuildTask\bin\RE.BuildTask.dll</TaskDll>
    <GenerateEditorExecutable>True</GenerateEditorExecutable>
    <ProjectGuid>{0E0A84AF-67DF-4030-BEB3-0E0B45D5F1F1}</ProjectGuid>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <UsingTask TaskName="RE.BuildTask.EngineBuildTask" AssemblyFile="$(TaskDll)" />
  <Import Project="../BuildTargets/RE.Common.targets" />
  <Target Name="BuildAll">
    <MSBuild Projects="../RE.BuildTask/RE.BuildTask.csproj" Targets="Restore;Build" />
    <MSBuild Projects="../RE.Launcher.Game/RE.Launcher.Game.csproj" Targets="Restore;Publish" Properties=" &#xD;&#xA;				 ApplicationIcon=$(ApplicationIcon);&#xD;&#xA;				 InformationalVersion=$(Version);&#xD;&#xA;				 RuntimeIdentifier=win-x64;&#xD;&#xA;				 PublishSingleFile=True;&#xD;&#xA;				 Configuration=Production;&#xD;&#xA;				 PublishDir=$(PubDir)" />
    <MSBuild Condition="'$(GenerateEditorExecutable)' == 'True'" Projects="../RE.Launcher.Editor/RE.Launcher.Editor.csproj" Targets="Restore;Publish" Properties=" &#xD;&#xA;				 ApplicationIcon=../editor.ico;&#xD;&#xA;				 InformationalVersion=$(Version);&#xD;&#xA;				 RuntimeIdentifier=win-x64;&#xD;&#xA;				 PublishSingleFile=True;&#xD;&#xA;				 Configuration=Production;&#xD;&#xA;				 PublishDir=$(PubDir)" />
    <EngineBuildTask AssetsFolder="$(PubDir)Assets" OutputFolder="$(PubDir)paks" CompressAssets="true" GenerateZip="true" Version="$(Version)" />
  </Target>
</Project>