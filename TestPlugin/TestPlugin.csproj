<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Configurations>Debug;Release;Production</Configurations>
		<NoWarn>NU1701;NU1702;NU1510;CS1591</NoWarn>

	</PropertyGroup>


	<ItemGroup>
		<ProjectReference Include="..\RE\RE.csproj" />
	</ItemGroup>


	<Target Name="PostBuild" AfterTargets="Build">
		<Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFiles="$(SolutionDir)RE\Dll\PLUGINS\$(TargetFileName)" />
	</Target>
</Project>
