<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="../BuildTargets/RE.Common.targets"/>

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>$(ExeName)-Console</AssemblyName>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="RE.Launcher.Game.Console.DefaultExeName">
			<_Parameter1>$(ExeName).exe</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

</Project>
